# au Qua Station (Realtek RTD1295). Fragment on top of the arm64 defconfig:
#   make ARCH=arm64 defconfig quastation.config
CONFIG_ARCH_REALTEK=y
CONFIG_PREEMPT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_RESET_SIMPLE=y
CONFIG_RTD119X_WATCHDOG=y
CONFIG_PRINTK_TIME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_LOCALVERSION="-quastation"
# CONFIG_LOCALVERSION_AUTO is not set

# Only Realtek. The vendor booti copies the Image to 0x100000 and it must end
# below the audio CPU firmware at 0x1b00000, so the Image stays under 26 MiB.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_GOOGLE is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# Not needed on the Qua Station; keeps the Image small.
# CONFIG_XEN is not set
# CONFIG_ACPI is not set
# CONFIG_HIBERNATION is not set
# CONFIG_NUMA is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_INFINIBAND is not set
# CONFIG_CRYPTO_DEV_CCREE is not set

# ---- Qua Station drivers ----
CONFIG_RTD1295_IRQ_MUX=y
CONFIG_GPIO_RTD=y
CONFIG_MFD_SYSCON=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# SATA
CONFIG_ATA=y
CONFIG_SATA_HOST=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_PHY_RTD1295_SATA=y
CONFIG_BLK_DEV_SD=y
# PCIe + Wi-Fi (modules: firmware rtlwifi/rtl8192eefw.bin, rtl8812aefw*.bin from the rootfs)
CONFIG_PCI=y
CONFIG_PCIE_RTD1295=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL_CARDS=y
CONFIG_RTLWIFI=m
CONFIG_RTL8192EE=m
CONFIG_RTL8821AE=m
# I2C, thermal, fan, RNG, eFuse, keys, LEDs
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_CHARDEV=y
CONFIG_RTD1295_THERMAL=y
CONFIG_SENSORS_RTD1295_FAN=y
CONFIG_HW_RANDOM_RTD1295=y
CONFIG_NVMEM_RTD1295_EFUSE=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_TIMER=y
# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_RTK=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_RTK_RTD_USB2PHY=y
CONFIG_PHY_RTK_RTD_USB3PHY=y
CONFIG_PHY_RTD1295_RLE0599=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_ACM=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_OPTION=y
CONFIG_USB_SERIAL_QUALCOMM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=m
# Clock, pinctrl, eMMC, SD
CONFIG_COMMON_CLK_RTD1295=y
CONFIG_PINCTRL_RTD=y
CONFIG_PINCTRL_RTD1295=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_RTD1295_SD=y
# Filesystems for the rootfs and USB sticks / SD cards
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXT4_FS=y
CONFIG_RFKILL=y
CONFIG_MMC_RTD1295_EMMC=y
CONFIG_SENSORS_GPIO_FAN=y

# --- size ---
# What the board needs to boot is built in; other SoCs' drivers are off; general
# features are modules (below). EXPERT is only needed so VT can be switched off.

# General: -Os, 4 CPUs, no debug info / KALLSYMS_ALL / kexec / profiling
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_NR_CPUS=4
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_PROFILING is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_PTDUMP_DEBUGFS is not set
# CONFIG_RUNTIME_TESTING_MENU is not set
# CONFIG_MEMTEST is not set
# CONFIG_BLK_DEBUG_FS is not set

# CPU features the Cortex-A53 does not have; no UEFI (booti), so no EFI stub / DMI
# CONFIG_ARM64_SVE is not set
# CONFIG_ARM64_SME is not set
# CONFIG_ARM64_MTE is not set
# CONFIG_ARM64_GCS is not set
# CONFIG_ARM64_POE is not set
# CONFIG_ARM64_AMU_EXTN is not set
# CONFIG_ARM64_RAS_EXTN is not set
# CONFIG_ARM64_BRBE is not set
# CONFIG_EFI is not set
# CONFIG_DMI is not set


